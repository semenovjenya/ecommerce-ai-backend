# OpenAI
# Do not commit real API keys. Put real values only into local .env files or secret managers.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
OPENAI_MEMORY_MODEL=gpt-4.1-mini

# Model profile and optional OpenRouter runtime
LLM_MODEL_PROFILE=openai_default
OPENROUTER_API_KEY=
OPENROUTER_MODEL=google/gemma-4-31b-it:free
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_HTTP_REFERER=
OPENROUTER_TITLE=AI-KAM Backend

# Langfuse Cloud observability. Keep disabled until the Cloud project and secrets exist.
LANGFUSE_ENABLED=false
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_BASE_URL=https://cloud.langfuse.com
LANGFUSE_TRACING_ENVIRONMENT=development
LANGFUSE_RELEASE=
LANGFUSE_SAMPLE_RATE=1.0
LANGFUSE_CAPTURE_MODE=full
LANGFUSE_MAX_FIELD_BYTES=262144
# true for the seven-day OpenAI + Langfuse comparison; false after cutover.
LANGFUSE_OPENAI_AGENTS_DUAL_EXPORT=true
SUPPLY_LATEST_KNOWN_AS_CURRENT=false

# Agent workflow and Manager Decision
AGENT_WORKFLOW_VERSION=v1
MANAGER_DECISION_ENABLED=false
DECISION_SIMULATION_MODE=off
# Pricing rollout is independent and shadow-only in v1.
DECISION_SIMULATION_PRICING_MODE=off
DECISION_SIMULATION_QUEUE_NAME=decision-simulations
DECISION_SIMULATION_MAINTENANCE_QUEUE_NAME=decision-simulations-maintenance
DECISION_SIMULATION_SAMPLE_COUNT=500
DECISION_SIMULATION_BATCH_SIZE=50
DECISION_SIMULATION_JOB_TIMEOUT_SECONDS=900
DECISION_SIMULATION_STALE_AFTER_SECONDS=1200
DECISION_SIMULATION_LLM_CRITIC_ENABLED=true
DECISION_SIMULATION_METRICS_PORT=9101
DECISION_SIMULATION_RECONCILER_METRICS_PORT=9102
AGENT_WORKER_METRICS_PORT=9103
AGENT_WORKER_PROMETHEUS_MULTIPROC_DIR=/tmp/agent-worker-prometheus
AGENT_WORKER_CONCURRENCY=4
AGENT_TOOL_CACHE_TTL_SECONDS=3600
AGENT_SYNC_CROSS_CHECK_CONCURRENCY=4
SIMULATION_WORKER_MODE=worker
MANAGER_DAILY_ENABLED=false
MANAGER_DAILY_HOUR=9
MANAGER_DAILY_TIMEZONE=Europe/Moscow
MANAGER_DAILY_CHAT_ID=manager-daily
MANAGER_JWT_SECRET=replace-with-a-long-random-secret
MANAGER_JWT_TTL_SECONDS=900
MANAGER_JWT_ISSUER=ai-ecom-manager
MANAGER_BOOTSTRAP_ADMIN_USERNAME=
MANAGER_BOOTSTRAP_ADMIN_PASSWORD=

# M1.5 read-only agent state/history BFF. Keep unset until the private runtime is deployed.
COMMERCE_AGENT_ENVIRONMENT=development
COMMERCE_AGENT_INTERNAL_URL=
COMMERCE_AGENT_SERVICE_TOKEN=
COMMERCE_AGENT_TENANT_ID=

# Wildberries write gates. Keep disabled until rollout checks pass.
WB_ADS_WRITE_ENABLED=false
WB_PRICE_WRITE_ENABLED=false
WB_API_SANDBOX=true
WB_PROMOTION_TOKEN=
WB_PRICES_TOKEN=

# Backend runtime and queue
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
BACKEND_BASE_URL=http://127.0.0.1:8000
REDIS_URL=redis://localhost:6379/0
AGENT_QUEUE_NAME=agent-runs
AGENT_JOB_TIMEOUT_SECONDS=900
EXPERIMENT_PROGRAM_QUEUE_NAME=experiment-programs
EXPERIMENT_PROGRAM_JOB_TIMEOUT_SECONDS=900
EXPERIMENT_PROGRAM_OUTBOX_LEASE_SECONDS=60
# LISTEN/NOTIFY wakes immediately; this scan only recovers missed notifications.
EXPERIMENT_PROGRAM_OUTBOX_RECOVERY_SECONDS=30
# Low-frequency safety scan; normal dispatch is driven by LISTEN/NOTIFY.
EXPERIMENT_PROGRAM_STALE_AFTER_SECONDS=300
EXPERIMENT_PROGRAM_SIMULATION_MAX_RECONCILES=3
EXPERIMENT_PROGRAM_AUTO_ATTACH=false

# Analytics PostgreSQL for local runtime
POSTGRES_HOST=localhost
POSTGRES_PORT=55434
POSTGRES_DB=wb_analytics
POSTGRES_USER=analytics_user
POSTGRES_PASSWORD=
POSTGRES_SSLMODE=disable
POSTGRES_POOL_MIN_SIZE=1
POSTGRES_POOL_MAX_SIZE=10
POSTGRES_POOL_TIMEOUT_SECONDS=10

# Analytics PostgreSQL for Docker Compose
# These values are mapped into POSTGRES_* variables inside the backend container.
ANALYTICS_POSTGRES_HOST=host.docker.internal
ANALYTICS_POSTGRES_PORT=55434
ANALYTICS_POSTGRES_DB=wb_analytics
ANALYTICS_POSTGRES_USER=analytics_user
ANALYTICS_POSTGRES_PASSWORD=
ANALYTICS_POSTGRES_SSLMODE=disable

# Chat memory PostgreSQL
MEMORY_POSTGRES_HOST=localhost
MEMORY_POSTGRES_PORT=55435
MEMORY_POSTGRES_DB=postgresmemory
MEMORY_POSTGRES_USER=postgresmemory_user
MEMORY_POSTGRES_PASSWORD=portfolio_local_password
MEMORY_POSTGRES_SSLMODE=disable
MEMORY_CONTEXT_MESSAGE_LIMIT=12
MEMORY_POSTGRES_POOL_MIN_SIZE=1
MEMORY_POSTGRES_POOL_MAX_SIZE=10
MEMORY_POSTGRES_POOL_TIMEOUT_SECONDS=10

# Optional Dalkos PostgreSQL integration
DALKOS_POSTGRES_HOST=localhost
DALKOS_POSTGRES_PORT=4444
DALKOS_POSTGRES_DB=Далкос
DALKOS_POSTGRES_USER=semenovjenya
DALKOS_POSTGRES_PASSWORD=
DALKOS_POSTGRES_SSLMODE=disable

# Optional Airflow document pipeline
AIRFLOW_BASE_URL=http://127.0.0.1:8082
AIRFLOW_USERNAME=admin
AIRFLOW_PASSWORD=admin
AIRFLOW_CONTRACT_DAG_ID=contract_document_ingest

# SKU preview source
SKU_PREVIEW_SCHEMA=analytics_ai
SKU_PREVIEW_TABLE=wb_sku_ai_analysis
SKU_PREVIEW_SKU_COLUMN=vendor_code
SKU_PREVIEW_WB_NM_ID_COLUMN=nm_id
SKU_PREVIEW_TITLE_COLUMN=title
SKU_PREVIEW_IMAGE_URL_COLUMN=main_photo_url
SKU_PREVIEW_PRODUCT_URL_COLUMN=product_url
